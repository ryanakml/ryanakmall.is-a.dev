---
import Base from '../layouts/Base.astro';
import { getImage } from 'astro:assets';
import heroMobile from '../assets/hero-mobile.png';
import heroTablet from '../assets/hero-tablet.png';
import heroDesktop from '../assets/hero-desktop.png';
import ProductArtwork from '../components/ProductArtwork.astro';
import ProjectLens from '../components/ProjectLens.astro';
import '../styles/b.css';

import { contributions } from '../data/contributions';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const [mobileHero, tabletHero, desktopHero] = await Promise.all(
  [heroMobile, heroTablet, heroDesktop].map(src => getImage({ src, width: 1000, format: 'webp', quality: 85 }))
);
---

<Base title="Ryan Akmal · Thinking out loud" description="Software, questions, and a little of the person behind them. The personal home of Ryan Akmal Pasya." bodyClass="concept-b">
  <SiteHeader />

  <main id="main">
    <section class="b-hero b-frame" aria-labelledby="b-title">
      <h1 id="b-title" class="b-hero-title">
        <span class="b-title-first" data-b-load>Thinking</span>
        <span class="b-title-second" data-b-load>
          <span>out</span>
          <picture class="b-inline-picture" aria-hidden="true">
            <source media="(max-width: 600px)" srcset={mobileHero.src} type="image/webp" />
            <source media="(max-width: 900px)" srcset={tabletHero.src} type="image/webp" />
            <img src={desktopHero.src} alt="" width="1000" height="400" fetchpriority="high" />
          </picture>
          <span>loud</span>
        </span>
      </h1>
      <div class="b-hero-bottom">
        <p class="b-introduction" data-b-load>I'm Ryan, a software engineer. Here are a few things I've built and the questions that kept me going.</p>
        <a class="b-button" href="#work" data-b-load><span>See what I mean</span><span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section id="work" class="b-work b-frame" aria-labelledby="b-work-title">
      <div class="b-chapter-intro">
        <h2 id="b-work-title" data-b-reveal="title">One idea,<br />two builds</h2>
        <p class="b-lead" data-b-reveal="text">Two approaches to WhatsApp support: Wabrix connects a chatbot with a shared inbox; FlowDesk brings conversations, integrations and background work together.</p>
      </div>

      <article class="b-wabrix b-work-spread" aria-labelledby="b-wabrix-title">
        <figure class="b-work-figure" data-b-reveal="picture">
          <div class="b-art-frame"><ProductArtwork product="wabrix" /></div>
          <figcaption>Wabrix · Knowledge-backed replies and human takeover</figcaption>
        </figure>
        <div class="b-work-copy">
          <h3 id="b-wabrix-title" data-b-reveal="title">Wabrix</h3>
          <p data-b-reveal="text">A WhatsApp chatbot that answers from business knowledge. Your team can pause the bot and take over in the same conversation.</p>
          <a class="b-text-link" href="/work/#wabrix" data-b-reveal="text">Explore Wabrix</a>
        </div>
      </article>

      <article class="b-flowdesk b-work-spread" aria-labelledby="b-flowdesk-title">
        <div class="b-work-copy">
          <h3 id="b-flowdesk-title" data-b-reveal="title">FlowDesk</h3>
          <p data-b-reveal="text">A WhatsApp support workspace with team conversations and working integrations. Behind the inbox, stored events and background workers keep messages moving.</p>
          <a class="b-text-link" href="/work/#flowdesk" data-b-reveal="text">Explore FlowDesk</a>
          <details class="b-deeper" data-b-reveal="text">
            <summary>A little deeper <span class="b-details-mark" aria-hidden="true">+</span></summary>
            <div class="b-deeper-content">
              <p>FlowDesk stores incoming WhatsApp events in PostgreSQL and uses a transactional outbox to pass work to a separate worker. The interface stays focused on conversations while processing continues in the background.</p>
              <p>Version checks protect conversation assignment when two operators act at once.</p>
            </div>
          </details>
        </div>
        <figure class="b-work-figure" data-b-reveal="picture">
          <ProjectLens />
        </figure>
      </article>
      <a class="b-text-link b-all-work" href="/work/">A closer look at the work <span aria-hidden="true">↗</span></a>
    </section>

    <section class="b-deadbolt" aria-labelledby="b-deadbolt-title">
      <div class="b-frame">
        <div class="b-deadbolt-intro">
          <h2 id="b-deadbolt-title" data-b-reveal="title">Work that<br />keeps moving</h2>
          <div data-b-reveal="text">
            <p class="b-lead">A workflow engine, built with a friend.</p>
            <p>Deadbolt orchestrates pipelines across multiple workers. Inspect progress, manage execution and recover interrupted work without restarting completed steps.</p>
            <p>Implemented through milestone M4 in Go and PostgreSQL, with orchestration, execution management and recovery mechanisms.</p>
            <a class="b-text-link" href="/work/#deadbolt">Explore Deadbolt</a>
          </div>
        </div>
        <figure class="b-deadbolt-figure" data-b-reveal="picture">
          <div class="b-art-frame"><ProductArtwork product="deadbolt" /></div>
          <figcaption>Deadbolt · Worker execution and recovery from saved progress</figcaption>
        </figure>
      </div>
    </section>

    <section id="contributions" class="b-contributions b-frame" aria-labelledby="b-contributions-title">
      <div class="b-contribution-top">
        <h2 id="b-contributions-title" data-b-reveal="title">In good<br />company</h2>
        <p class="b-lead" data-b-reveal="text">I also work in other people's codebases. A few fixes and documentation changes merged upstream.</p>
      </div>
      <div class="b-contribution-body">
        <figure class="b-contribution-figure" data-b-reveal="picture">
          <div class="b-art-frame"><img src="/art/products/celery.webp" alt="Editorial illustration of the Celery contribution: expanding the tilde character into a home-directory path" width="1400" height="1000" loading="lazy" /></div>
          <figcaption>Celery · Resolving home-directory paths before worker startup</figcaption>
        </figure>
        <div class="b-contribution-list">
          {contributions.map((item) => (
            <article class="b-contribution" data-b-reveal="item">
              <div class="b-contribution-name"><h3><a href={item.url}>{item.name}</a></h3><span>{item.detail}</span></div>
              <p>{item.description}</p>
              <a class="b-text-link" href={item.url}>Read the pull request</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="about" class="b-about b-frame" aria-labelledby="b-about-title">
      <h2 id="b-about-title" data-b-reveal="title">A little<br />about me</h2>
      <div class="b-about-body">
        <div class="b-about-main" data-b-reveal="text">
          <p>I like following a feature beyond the interface: into the data, the background work, and what happens when something goes wrong.</p>
          <p>I've learned independently, from data analysis and machine learning to LLMs, MLOps and full-stack development.</p>
        </div>
        <div class="b-about-side">
          <p class="b-process" data-b-reveal="text">I build personal projects, collaborate with friends and contribute upstream. I use AI as part of how I plan, build and review software.</p>
          <div class="b-aside" data-b-reveal="text">
            <p>I like conversations that start with “what if?” and end somewhere neither of us expected.</p>
            <p>Explaining an idea often helps me see what I missed. So does a good question from someone else.</p>
          </div>
        </div>
      </div>
    </section>


  </main>
  <SiteFooter />
  <script>import '../scripts/b';</script>
</Base>
