---
import ProductArtwork from './ProductArtwork.astro';
interface Props { sizes?: string; context?: 'home' | 'work'; }
const { context = 'home' } = Astro.props;
const fullCapture = {src: '/art/products/flowdesk-desktop.webp'};
---
<div class="b-lens" data-lens>
  <div class="b-lens-controls" role="group" aria-label="Explore FlowDesk" hidden>
    <button type="button" data-lens-select="interface" aria-pressed="true" aria-controls="flowdesk-interface">Interface</button>
    <button type="button" data-lens-select="architecture" aria-pressed="false" aria-controls="flowdesk-architecture">Behind it</button>
  </div>
  <div id="flowdesk-interface" data-lens-panel="interface">
    <a class="b-art-frame b-capture" href={fullCapture.src} aria-label="Open full FlowDesk interface image">
      <ProductArtwork product="flowdesk" context={context} />
    </a>
    <p class="b-picture-note">WhatsApp support · Review an AI draft</p>
    <p class="b-picture-source">FlowDesk · Inbox and AI-assisted reply workflow</p>
    <a class="b-picture-link b-text-link" href={fullCapture.src}>Open full image <span aria-hidden="true">↗</span></a>
  </div>
  <div id="flowdesk-architecture" data-lens-panel="architecture">
    <div class="b-art-frame"><img src="/art/products/flowdesk-behind.webp" alt="Version-checked assignment: Jamie claims a conversation; Taylor’s stale claim receives a conflict" width="1250" height="760" loading="lazy" /></div>
    <p class="b-picture-note">One conversation, one owner</p>
    <p class="b-picture-source">FlowDesk · Version-checked conversation assignment</p>
  </div>
</div>
